{
  "name": "bitburner-typescript-template",
  "version": "2.0.0",
  "scripts": {
    "transpile": "babel src --extensions \".ts,.tsx,.js,.jsx\" --out-dir dist --copy-files",
    "watch:transpile": "babel src --extensions \".ts,.tsx,.js,.jsx\" --out-dir dist --copy-files --watch",
    "watch:local": "node build/watch.js",
    "watch:remote": "bitburner-filesync",
    "watch:init": "node build/init.js",
    "watch:all": "concurrently \"npm:watch:transpile\" \"npm:watch:local\" \"npm:watch:remote\"",
    "typecheck": "tsc --noEmit",
    "watch": "npm run watch:init && npm run typecheck && npm run watch:all"
  },
  "author": "hydroflame, Hoekstraa, based on work by SlyCedix",
  "devDependencies": {
    "@types/react": "^18.2.18",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^5.35.1",
    "@typescript-eslint/parser": "^5.35.1",
    "bitburner-filesync": "^1.1.5",
    "chokidar": "^3.5.3",
    "concurrently": "^7.4.0",
    "eslint": "^8.22.0",
    "fast-glob": "^3.2.12",
    "sync-directory": "^5.1.7",
    "typescript": "^4.7.4",
    "@babel/cli": "^7.22.0",
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/preset-typescript": "^7.22.0"
  }
}
